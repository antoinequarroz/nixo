# Copy to .env and fill in. Without a server, the duo runs in simulated mode.

# Local test server (npm run server, SQLite). "auto" finds this computer from
# the phone; or give its address, e.g. http://192.168.1.20:8787.
# Ignored as soon as the Supabase keys below are set.
EXPO_PUBLIC_LOCAL_SERVER=auto

# Supabase → Project Settings → API (never put the service_role key here)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat → Project → API keys (public app-specific keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Public page with the privacy policy and terms (linked from Settings)
EXPO_PUBLIC_LEGAL_URL=
# Set to 1 to keep the clock lab in a test build (always shown in dev)
EXPO_PUBLIC_SHOW_LAB=
